<Window x:Class="BoostBayWpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoostBayWpf.ViewModels"
        xmlns:views="clr-namespace:BoostBayWpf.Views"
        Title="BoostBay - admin" Height="650" Width="1050">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#DDDDDD">
            <Button Content="Alkatrészek" Command="{Binding ProductsCommand}" Margin="5"/>
            <Button Content="Kategóriák" Command="{Binding CategoriesCommand}" Margin="5"/>
            <Button Content="Rendelések" Command="{Binding OrdersCommand}" Margin="5"/>
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Current.Status}"/>
        </StatusBar>
        <ContentControl Content="{Binding Current}" Margin="10"/>
    </DockPanel>
</Window>
