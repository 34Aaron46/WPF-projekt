<UserControl x:Class="BoostBayWpf.Views.ProductsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBox Width="200" Text="{Binding SearchText}"/>
                <Button Content="Keresés" Command="{Binding SearchCommand}"/>
                <Button Content="Összes" Command="{Binding LoadCommand}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Kategória" Binding="{Binding Category.Name}"/>
                    <DataGridTextColumn Header="Adat" Binding="{Binding SpecValue}"/>
                    <DataGridTextColumn Header="Ár" Binding="{Binding Price}"/>
                    <DataGridTextColumn Header="Készlet" Binding="{Binding Stock}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GroupBox Grid.Column="1" Header="Alkatrész" Padding="8">
            <StackPanel>
                <Label Content="Név"/>
                <TextBox Text="{Binding SelectedProduct.Name}"/>
                <Label Content="Műszaki adat"/>
                <TextBox Text="{Binding SelectedProduct.SpecValue}"/>
                <Label Content="Ár"/>
                <TextBox Text="{Binding SelectedProduct.Price}"/>
                <Label Content="Készlet"/>
                <TextBox Text="{Binding SelectedProduct.Stock}"/>
                <Label Content="Kategória"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedProduct.CategoryId}"/>
                <WrapPanel>
                    <Button Content="Új" Command="{Binding NewCommand}"/>
                    <Button Content="Mentés" Command="{Binding SaveCommand}"/>
                    <Button Content="Törlés" Command="{Binding DeleteCommand}"/>
                    <Button Content="+10 készlet" Command="{Binding RestockCommand}"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
