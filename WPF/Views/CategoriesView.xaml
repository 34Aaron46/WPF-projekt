<UserControl x:Class="BoostBayWpf.Views.CategoriesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Leírás" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Label Grid.Row="1" Content="A kategória termékei:" Margin="0,10,0,0"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding CategoryProducts}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Ár" Binding="{Binding Price}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GroupBox Grid.Column="1" Header="Kategória" Padding="8">
            <StackPanel>
                <Label Content="Név"/>
                <TextBox Text="{Binding SelectedCategory.Name}"/>
                <Label Content="Leírás"/>
                <TextBox Text="{Binding SelectedCategory.Description}"/>
                <WrapPanel>
                    <Button Content="Új" Command="{Binding NewCommand}"/>
                    <Button Content="Mentés" Command="{Binding SaveCommand}"/>
                    <Button Content="Törlés" Command="{Binding DeleteCommand}"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
