<Window x:Class="TuningKatalogusWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TuningKatalogusWpf.Views"
        Title="Tuning katalógus" Height="650" Width="1050">

    <!-- minden fül egy külön nézet -->
    <TabControl Margin="5">
        <TabItem Header="Termékek">
            <views:TermekekView/>
        </TabItem>
        <TabItem Header="Kategóriák">
            <views:KategoriakView/>
        </TabItem>
        <TabItem Header="Rendelések">
            <views:RendelesekView/>
        </TabItem>
    </TabControl>
</Window>
