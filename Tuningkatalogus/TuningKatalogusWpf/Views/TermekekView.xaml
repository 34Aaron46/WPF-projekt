<UserControl x:Class="TuningKatalogusWpf.Views.TermekekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuningKatalogusWpf.ViewModels"
             Loaded="UserControl_Loaded">

    <UserControl.DataContext>
        <vm:TermekekViewModel/>
    </UserControl.DataContext>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Uzenet}"/>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- bal oldal: keresés és táblázat -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBox Width="200" Text="{Binding KeresoSzoveg, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Keresés" Command="{Binding KeresesCommand}"/>
                    <Button Content="Összes" Command="{Binding OsszesCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Termekek}"
                          SelectedItem="{Binding KivalasztottTermek}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*"/>
                        <DataGridTextColumn Header="Kategória" Binding="{Binding Kategoria.Nev}"/>
                        <DataGridTextColumn Header="Adat" Binding="{Binding MuszakiAdat}"/>
                        <DataGridTextColumn Header="Ár" Binding="{Binding Ar}"/>
                        <DataGridTextColumn Header="Készlet" Binding="{Binding Keszlet}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- jobb oldal: a kiválasztott termék szerkesztése -->
            <GroupBox Grid.Column="1" Header="Termék" Padding="8">
                <StackPanel>
                    <Label Content="Név"/>
                    <TextBox Text="{Binding KivalasztottTermek.Nev}"/>

                    <Label Content="Műszaki adat"/>
                    <TextBox Text="{Binding KivalasztottTermek.MuszakiAdat}"/>

                    <Label Content="Ár"/>
                    <TextBox Text="{Binding KivalasztottTermek.Ar}"/>

                    <Label Content="Készlet"/>
                    <TextBox Text="{Binding KivalasztottTermek.Keszlet}"/>

                    <Label Content="Kategória"/>
                    <ComboBox ItemsSource="{Binding Kategoriak}"
                              DisplayMemberPath="Nev"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding KivalasztottTermek.KategoriaId}"/>

                    <WrapPanel>
                        <Button Content="Új" Command="{Binding UjCommand}"/>
                        <Button Content="Mentés" Command="{Binding MentesCommand}"/>
                        <Button Content="Törlés" Command="{Binding TorlesCommand}"/>
                        <Button Content="+10 készlet" Command="{Binding KeszletCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
