<UserControl x:Class="TuningKatalogusWpf.Views.KategoriakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TuningKatalogusWpf.ViewModels"
             Loaded="UserControl_Loaded">

    <UserControl.DataContext>
        <vm:KategoriakViewModel/>
    </UserControl.DataContext>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Uzenet}"/>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- bal oldal: kategoriak es alatta a kijelolt kategoria termekei -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Kategoriak}"
                          SelectedItem="{Binding KivalasztottKategoria}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev}"/>
                        <DataGridTextColumn Header="Leírás" Binding="{Binding Leiras}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Label Grid.Row="1" Content="A kategória termékei:" Margin="0,10,0,0"/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding KategoriaTermekek}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*"/>
                        <DataGridTextColumn Header="Ár" Binding="{Binding Ar}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- jobb oldal: a kijelolt kategoria szerkesztese -->
            <GroupBox Grid.Column="1" Header="Kategória" Padding="8">
                <StackPanel>
                    <Label Content="Név"/>
                    <TextBox Text="{Binding KivalasztottKategoria.Nev}"/>

                    <Label Content="Leírás"/>
                    <TextBox Text="{Binding KivalasztottKategoria.Leiras}"/>

                    <WrapPanel>
                        <Button Content="Új" Command="{Binding UjCommand}"/>
                        <Button Content="Mentés" Command="{Binding MentesCommand}"/>
                        <Button Content="Törlés" Command="{Binding TorlesCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>